# APP_BASE_PATH is auto-detected by index.php (the parent of /public), so no
# hardcoded server path is needed — the app works in whatever folder it's deployed
# to (e.g. moneytidecn-app via Hostinger Git pull).

# ── Security headers ──────────────────────────────────────────────────────────
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# ── Gzip / Brotli compression ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/rss+xml application/xml text/xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff2
</IfModule>

# ── Browser cache: versioned static assets (CSS / JS / fonts) — 1 year ────────
# CSS and JS are served with ?v=<filemtime> query strings in layout.php,
# so immutable long-cache is safe: URL changes when content changes.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Images: 7-day cache (no content-hash versioning on image paths)
    <FilesMatch "\.(png|jpg|jpeg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # SVG icons/illustrations: 7 days (og-image.svg may be updated)
    <FilesMatch "\.svg$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 7 days"
    ExpiresByType image/png               "access plus 7 days"
    ExpiresByType image/jpeg              "access plus 7 days"
    ExpiresByType image/webp              "access plus 7 days"
    ExpiresByType image/gif               "access plus 7 days"
    ExpiresByType image/x-icon            "access plus 7 days"
</IfModule>

# ── URL rewriting ─────────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
